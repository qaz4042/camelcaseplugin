<idea-plugin>
    <id>io.github.qaz4042.camelcasefix</id>
    <name>CamelCaseFix</name>
    <version>1.0.0</version>
    <vendor url="https://github.com/qaz4042/camelcaseplugin">qaz4042</vendor>

    <description><![CDATA[
      Switch easily between kebab-case, SNAKE_CASE, PascalCase, camelCase, snake_case or space case. See Edit menu or use ⇧ + ⌥ + U / Shift + Alt + U.
      <br />
      Please have a look at the preferences of this plugin: 
      You can disable some conversions or change their order.
      <br />
      This is a community-maintained fork of the original CamelCase plugin.
      It fixes the missing Apache Commons Lang dependency on modern IntelliJ IDEs.
      Source: https://github.com/qaz4042/camelcaseplugin
      ]]></description>

    <change-notes><![CDATA[
      <p>If you have any comments please let me know.</p>

      <p>Release 1.0.0:
      <ul>
        <li>Fix missing WordUtils dependency on IntelliJ IDEA 2026.2+</li>
      </ul>
      </p>

      ]]>
    </change-notes>

    <!-- please see http://confluence.jetbrains.net/display/IDEADEV/Build+Number+Ranges for description -->
    <idea-version since-build="262"/>

    <!-- please see http://confluence.jetbrains.net/display/IDEADEV/Plugin+Compatibility+with+IntelliJ+Platform+Products
         on how to target different products -->
    <!-- uncomment to enable plugin in all products
    -->
    <depends>com.intellij.modules.lang</depends>

    <application-components>
        <!-- Add your application components here -->
    </application-components>

    <project-components>
        <!-- Add your project components here -->
    </project-components>

    <actions>
        <!-- Add your actions here -->
        <action id="io.github.qaz4042.camelcasefix.ToggleCamelCase" class="de.netnexus.CamelCasePlugin.ToggleCamelCase"
                text="Toggle Camel Case"
                description="Switches between CamelCase, camelCase and snake_case">
            <add-to-group group-id="EditSmartGroup" anchor="after" relative-to-action="EditorToggleCase"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift alt U"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <projectService
                serviceImplementation="de.netnexus.CamelCasePlugin.CamelCaseConfig"/>
        <projectConfigurable groupId="editor" displayName="Camel Case" id="io.github.qaz4042.camelcasefix.preferences"
                             instance="de.netnexus.CamelCasePlugin.CamelCasePluginConfigurable"/>
    </extensions>
</idea-plugin>
